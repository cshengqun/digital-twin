# 复制为 .env 并按需修改
APP_ENV=dev
APP_ADDR=:8080
APP_BASE_URL=http://localhost:8080

# 数据库 / 缓存 —— 填火山引擎托管实例的连接串（白名单放行你的出口 IP）
# 云数据库 PostgreSQL：控制台实例详情里复制连接串
POSTGRES_DSN=postgres://<user>:<password>@<pg-host>:5432/<db>?sslmode=disable
# 云数据库 Redis：实例详情里的访问地址与密码
REDIS_ADDR=<redis-host>:6379
REDIS_PASSWORD=<redis-password>

# 火山方舟（Ark）：对话模型接入点
# 控制台：模型服务 → 接入点 → 创建接入点，把接入点 ID 填到 ARK_MODEL_ID
ARK_BASE_URL=https://ark.cn-beijing.volces.com
ARK_API_KEY=<your-ark-api-key>
ARK_MODEL_ID=<your-endpoint-id>

# Phase 1 · 检索与向量（B 方案：Qdrant 自建，docker 部署在本机/服务器）
# 本地开发 http://localhost:6333；服务器上 http://127.0.0.1:6333
QDRANT_ADDR=http://localhost:6333
# 方舟 embedding 模型 ID（同 ARK_API_KEY 可用；默认 doubao-embedding-large，效果最佳）
EMBEDDING_MODEL=doubao-embedding-large

# 首次启动的登录账号（users 表为空时写入）
ADMIN_USERNAME=admin
# 必须改为强密码（可用 openssl rand -base64 24 生成）
ADMIN_PASSWORD=<strong-password>

# Blogs · 图片与飞书导入
# 博客图片落盘目录（相对服务工作目录），通过 /media/blog/ 公开只读
BLOG_MEDIA_DIR=media/blog
# 非空时开启 POST /api/blogs/import（Bearer Token），供本机脚本把飞书文档连同图片导入博客
# 生成：openssl rand -hex 24
BLOG_IMPORT_TOKEN=<random-token>
